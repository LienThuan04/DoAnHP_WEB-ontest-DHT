// prisma/schema.prisma
// Define your database models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// HỆ THI OnTest (chuyển từ DHT_OneTest — MySQL → đây là PostgreSQL)
// Phase 0-1: chỉ 4 model cốt lõi cho auth + RBAC.
// Các model nghiệp vụ (monhoc, cauhoi, dethi, ketqua, nhom...) bổ sung ở Phase 2+.
// Giữ @@map tên bảng tiếng Việt để dễ map ngược về PHP (xem docs/04).
// ─────────────────────────────────────────────────────────────────────────────

/// Người dùng hệ thi — bảng `nguoidung`
model NguoiDung {
  id          String    @id
  email       String    @unique
  googleid    String?
  hoten       String
  gioitinh    Boolean?
  ngaysinh    DateTime? @db.Date
  avatar      String?   @default("ANHSV.png")
  ngaythamgia DateTime  @default(now()) @db.Date
  matkhau     String?
  trangthai   Int       @default(1)
  sodienthoai Int?
  token       String?
  otp         String?
  manhomquyen Int?

  nhomQuyen NhomQuyen? @relation(fields: [manhomquyen], references: [manhomquyen])

  @@map("nguoidung")
}

/// Nhóm quyền (role hệ thi) — bảng `nhomquyen`
model NhomQuyen {
  manhomquyen  Int     @id @default(autoincrement())
  tennhomquyen String
  trangthai    Boolean @default(true)

  nguoiDung    NguoiDung[]
  chiTietQuyen ChiTietQuyen[]

  @@map("nhomquyen")
}

/// Chi tiết quyền (role × chức năng × hành động) — bảng `chitietquyen`
model ChiTietQuyen {
  manhomquyen Int
  chucnang    String
  hanhdong    String

  nhomQuyen       NhomQuyen       @relation(fields: [manhomquyen], references: [manhomquyen], onDelete: Cascade)
  danhMucChucNang DanhMucChucNang @relation(fields: [chucnang], references: [chucnang])

  @@id([manhomquyen, chucnang, hanhdong])
  @@map("chitietquyen")
}

/// Danh mục chức năng (resource) — bảng `danhmucchucnang`
model DanhMucChucNang {
  chucnang    String  @id
  tenchucnang String?

  chiTietQuyen ChiTietQuyen[]

  @@map("danhmucchucnang")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 — Dữ liệu nền: Năm học & Học kỳ (port từ NamHocModel.php).
// ─────────────────────────────────────────────────────────────────────────────

/// Năm học — bảng `namhoc`. Mỗi năm học có nhiều học kỳ (tự sinh khi thêm).
model NamHoc {
  manamhoc  Int      @id @default(autoincrement())
  tennamhoc String
  trangthai Int?     @default(1)
  ngaytao   DateTime @default(now())

  hocKy HocKy[]

  @@map("namhoc")
}

/// Học kỳ — bảng `hocky`. Thuộc 1 năm học; `sohocky` là thứ tự kỳ (1,2,3...).
model HocKy {
  mahocky  Int      @id @default(autoincrement())
  tenhocky String
  manamhoc Int
  ngaytao  DateTime @default(now())
  sohocky  Int      @default(1)

  namHoc NamHoc @relation(fields: [manamhoc], references: [manamhoc], onDelete: Cascade)

  @@map("hocky")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 — Dữ liệu nền: Môn học & Chương (port từ MonHocModel/ChuongModel.php).
// ─────────────────────────────────────────────────────────────────────────────

/// Môn học — bảng `monhoc`. Khoá chính là mã môn (chuỗi, vd 'LTW001').
model MonHoc {
  mamonhoc       String @id
  tenmonhoc      String
  sotinchi       Int?
  sotietlythuyet Int?
  sotietthuchanh Int?
  trangthai      Int?

  chuong Chuong[]

  @@map("monhoc")
}

/// Chương của môn học — bảng `chuong`. Xoá mềm bằng trangthai = 0.
model Chuong {
  machuong  Int     @id @default(autoincrement())
  tenchuong String
  mamonhoc  String
  trangthai Int?

  monHoc MonHoc @relation(fields: [mamonhoc], references: [mamonhoc], onDelete: Cascade)

  @@map("chuong")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — Ngân hàng câu hỏi (port từ CauHoiModel/CauTraLoiModel.php + doan_van).
// Giữ FK dạng scalar như DB gốc (MySQL không khai báo FOREIGN KEY thật).
// Riêng cauhoi ↔ cautraloi có quan hệ để cascade xoá đáp án khi xoá câu hỏi.
// ─────────────────────────────────────────────────────────────────────────────

/// Đoạn văn dùng cho câu hỏi đọc hiểu (reading) — bảng `doan_van`.
model DoanVan {
  madv     Int      @id @default(autoincrement())
  noidung  String
  tieude   String?
  mamonhoc String
  machuong Int?
  nguoitao String?
  trangthai Int?    @default(1)
  ngaytao  DateTime @default(now())

  @@map("doan_van")
}

/// Câu hỏi — bảng `cauhoi`. loai: 'mcq' | 'essay' | 'reading'.
/// dapan_dung chỉ dùng cho mcq (A-D). madv trỏ tới đoạn văn khi loai='reading'.
/// hinhanh lưu blob ảnh (mediumblob → Bytes).
model CauHoi {
  macauhoi   Int     @id @default(autoincrement())
  noidung    String
  dapan_dung String? @db.Char(1)
  dokho      Int
  mamonhoc   String
  machuong   Int
  nguoitao   String?
  trangthai  Int?    @default(1)
  loai       String  @default("mcq")
  madv       Int?
  hinhanh    Bytes?

  cauTraLoi CauTraLoi[]

  @@map("cauhoi")
}

/// Đáp án của câu hỏi — bảng `cautraloi`. ladapan: 1 = đáp án đúng.
model CauTraLoi {
  macautl   Int     @id @default(autoincrement())
  macauhoi  Int
  noidungtl String
  ladapan   Int     @db.SmallInt
  hinhanh   Bytes?

  cauHoi CauHoi @relation(fields: [macauhoi], references: [macauhoi], onDelete: Cascade)

  @@map("cautraloi")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 5 (kéo lên trước) — Phân công giảng dạy: bảng `phancong`.
// Gắn người dùng (giảng viên) với môn học theo năm học + học kỳ. Trang ngân hàng
// câu hỏi dùng để chỉ cho phép thao tác trên môn được phân công (getSubjectAssignment).
// PK ghép (mamonhoc, manguoidung, namhoc, hocky) như DB gốc; FK để dạng scalar.
// ─────────────────────────────────────────────────────────────────────────────

/// Phân công giảng dạy — bảng `phancong`. trangthai = 1: còn hiệu lực.
model PhanCong {
  mamonhoc    String
  manguoidung String
  namhoc      Int
  hocky       Int
  trangthai   Int      @default(1) @db.SmallInt
  ngaytao     DateTime @default(now())

  @@id([mamonhoc, manguoidung, namhoc, hocky])
  @@map("phancong")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Đề thi & làm bài (port từ test.php + DeThiModel/KetQua/ChiTietDeThi).
// Giữ FK scalar như DB gốc (MySQL không khai báo FOREIGN KEY thật) trừ các quan hệ
// cần cascade khi xoá đề / kết quả. Tên cột tiếng Việt giữ nguyên qua @map.
// ─────────────────────────────────────────────────────────────────────────────

/// Đề thi — bảng `dethi`. loaide: 0 = thủ công, 1 = tự động (random theo độ khó).
/// Các cờ tinyint hiển thị/trộn lưu dạng Int (0/1) như DB gốc.
model DeThi {
  made            Int       @id @default(autoincrement())
  monthi          String?
  nguoitao        String?
  tende           String?
  thoigiantao     DateTime  @default(now())
  thoigianthi     Int?
  thoigianbatdau  DateTime?
  thoigianketthuc DateTime?
  hienthibailam   Int?
  xemdiemthi      Int?
  xemdapan        Int?
  troncauhoi      Int?
  trondapan       Int?
  nopbaichuyentab Int?
  loaide          Int?
  mcq_de          Int?
  mcq_tb          Int?
  mcq_kho         Int?
  trangthai       Int?      @default(1)
  essay_de        Int?      @default(0)
  essay_tb        Int?      @default(0)
  essay_kho       Int?      @default(0)
  reading_de      Int?      @default(0)
  reading_tb      Int?      @default(0)
  reading_kho     Int?      @default(0)
  diem_tracnghiem Decimal?  @default(0) @db.Decimal(5, 2)
  diem_tuluan     Decimal?  @default(0) @db.Decimal(5, 2)
  diem_dochieu    Decimal?  @default(0) @db.Decimal(5, 2)

  chiTietDeThi ChiTietDeThi[]
  deThiTuDong  DeThiTuDong[]
  giaoDeThi    GiaoDeThi[]

  @@map("dethi")
}

/// Câu hỏi trong đề (đề thủ công) — bảng `chitietdethi`. thutu: thứ tự câu.
model ChiTietDeThi {
  made     Int
  macauhoi Int
  thutu    Int?

  deThi DeThi @relation(fields: [made], references: [made], onDelete: Cascade)

  @@id([made, macauhoi])
  @@map("chitietdethi")
}

/// Chương dùng cho đề tự động — bảng `dethitudong`. Gắn đề với các chương để random.
model DeThiTuDong {
  made     Int
  machuong Int

  deThi DeThi @relation(fields: [made], references: [made], onDelete: Cascade)

  @@id([made, machuong])
  @@map("dethitudong")
}

/// Giao đề cho nhóm/lớp — bảng `giaodethi`. manhom trỏ tới nhom (Phase 5, FK scalar).
model GiaoDeThi {
  made   Int
  manhom Int

  deThi DeThi @relation(fields: [made], references: [made], onDelete: Cascade)

  @@id([made, manhom])
  @@map("giaodethi")
}

/// Kết quả bài thi — bảng `ketqua`. makq là id tự tăng; ràng buộc duy nhất theo
/// (made, manguoidung) — mỗi người 1 kết quả/đề. trangthai: 'Chưa nộp'|'Đã nộp'.
/// trangthai_tuluan: 'Chưa chấm'|'Đang chấm'|'Đã chấm'.
model KetQua {
  makq             Int       @id @default(autoincrement())
  made             Int
  manguoidung      String    @default("")
  diemthi          Float?
  diem_dochieu     Float?    @default(0)
  thoigianvaothi   DateTime  @default(now())
  thoigianlambai   Int?
  socaudung        Int?
  solanchuyentab   Int?      @default(0)
  diem_tuluan      Float?    @default(0)
  trangthai_tuluan String?   @default("Chưa chấm")
  trangthai        String?   @default("Chưa nộp")
  thoigianketthuc  DateTime?

  chiTietKetQua ChiTietKetQua[]

  @@unique([made, manguoidung])
  @@map("ketqua")
}

/// Chi tiết bài làm (mỗi câu) — bảng `chitietketqua`. dapanchon: macautl được chọn.
model ChiTietKetQua {
  makq      Int
  macauhoi  Int
  thutu     Int? @default(0)
  dapanchon Int?

  ketQua KetQua @relation(fields: [makq], references: [makq], onDelete: Cascade)

  @@id([makq, macauhoi])
  @@map("chitietketqua")
}

/// Bài làm tự luận của SV — bảng `traloi_tuluan`. noidung: HTML câu trả lời.
model TraLoiTuLuan {
  id          Int      @id @default(autoincrement())
  makq        Int
  macauhoi    Int
  noidung     String?
  thoigianlam DateTime @default(now())

  hinhAnh HinhAnhTraLoiTuLuan[]

  @@map("traloi_tuluan")
}

/// Ảnh đính kèm bài làm tự luận — bảng `hinhanh_traloi_tuluan`. hinhanh: blob.
model HinhAnhTraLoiTuLuan {
  id        Int      @id @default(autoincrement())
  traloi_id Int
  hinhanh   Bytes?
  thoigian  DateTime @default(now())

  traLoiTuLuan TraLoiTuLuan @relation(fields: [traloi_id], references: [id], onDelete: Cascade)

  @@map("hinhanh_traloi_tuluan")
}

/// Điểm chấm tay từng câu tự luận — bảng `cham_tuluan`.
model ChamTuLuan {
  id       Int   @id @default(autoincrement())
  makq     Int
  macauhoi Int
  diem     Float @default(0)

  @@map("cham_tuluan")
}

// ─────────────────────────────────────────────────────────────────────────────
// Kéo lên trước cho Phase 4 — Nhóm/lớp (Phase 5) & Thông báo (Phase 6).
// Đề thi cần: giao đề cho nhóm (giaodethi.manhom), kiểm tra SV thuộc nhóm
// (chitietnhom), và tự sinh thông báo khi tạo đề (thongbao/chitietthongbao/
// trangthaithongbao). Chỉ thêm MODEL ở đây; UI quản lý nhóm/thông báo làm ở
// Phase 5/6. FK để scalar như DB gốc trừ chỗ cần cascade.
// ─────────────────────────────────────────────────────────────────────────────

/// Nhóm/lớp học phần — bảng `nhom`. mamoi: mã mời SV tham gia. trangthai=1 còn hiệu lực.
model Nhom {
  manhom    Int     @id @default(autoincrement())
  tennhom   String
  mamoi     String?
  siso      Int?    @default(0)
  ghichu    String?
  namhoc    Int?
  hocky     Int?
  trangthai Int?    @default(1)
  hienthi   Int?    @default(1)
  giangvien String  @default("")
  mamonhoc  String

  chiTietNhom ChiTietNhom[]

  @@map("nhom")
}

/// Thành viên nhóm — bảng `chitietnhom`. hienthi=1: còn trong nhóm.
model ChiTietNhom {
  manhom      Int
  manguoidung String @default("0")
  hienthi     Int?   @default(1)

  nhom Nhom @relation(fields: [manhom], references: [manhom], onDelete: Cascade)

  @@id([manhom, manguoidung])
  @@map("chitietnhom")
}

/// Thông báo — bảng `thongbao`. is_auto=1: sinh tự động (vd khi tạo đề thi).
model ThongBao {
  matb        Int       @id @default(autoincrement())
  noidung     String?
  thoigiantao DateTime?
  nguoitao    String    @default("")
  is_auto     Int?      @default(0)

  chiTietThongBao   ChiTietThongBao[]
  trangThaiThongBao TrangThaiThongBao[]

  @@map("thongbao")
}

/// Nhóm nhận thông báo — bảng `chitietthongbao`.
model ChiTietThongBao {
  matb   Int
  manhom Int

  thongBao ThongBao @relation(fields: [matb], references: [matb], onDelete: Cascade)

  @@id([matb, manhom])
  @@map("chitietthongbao")
}

/// Trạng thái đọc thông báo theo người dùng — bảng `trangthaithongbao`.
model TrangThaiThongBao {
  matb        Int
  manguoidung String
  trangthai   String? @default("chưa xem")

  thongBao ThongBao @relation(fields: [matb], references: [matb], onDelete: Cascade)

  @@id([matb, manguoidung])
  @@map("trangthaithongbao")
}

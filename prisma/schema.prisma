// prisma/schema.prisma
// Define your database models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  userName      String    @unique
  googleId      String?   @unique
  accountType   String    @default("local")
  avatarUrl     String?
  backgroundUrl String?
  description   String?
  password      String?
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sessions      Session[]
  files         File[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  roleName    String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model File {
  id           String   @id @default(uuid())
  fileName     String
  originalName String
  path         String   @unique
  mimeType     String
  size         Int?
  bucket       String
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  deviceId     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([deviceId])
}

model PendingRegistration {
  id           String    @id @default(uuid())
  email        String    @unique
  userName     String    @unique
  passwordHash String
  otpHash      String
  otpExpiresAt DateTime
  attemptCount Int       @default(0)
  resendAfter  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PendingUserUpdate {
  id             String    @id @default(uuid())
  userId         String    @unique
  newEmail       String?
  newUserName    String?
  newDescription String?
  otpHash        String
  otpExpiresAt   DateTime
  attemptCount   Int       @default(0)
  resendAfter    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// HỆ THI OnTest (chuyển từ DHT_OneTest — MySQL → đây là PostgreSQL)
// Phase 0-1: chỉ 4 model cốt lõi cho auth + RBAC.
// Các model nghiệp vụ (monhoc, cauhoi, dethi, ketqua, nhom...) bổ sung ở Phase 2+.
// Giữ @@map tên bảng tiếng Việt để dễ map ngược về PHP (xem docs/04).
// ─────────────────────────────────────────────────────────────────────────────

/// Người dùng hệ thi — bảng `nguoidung`
model NguoiDung {
  id          String    @id
  email       String    @unique
  googleid    String?
  hoten       String
  gioitinh    Boolean?
  ngaysinh    DateTime? @db.Date
  avatar      String?   @default("ANHSV.png")
  ngaythamgia DateTime  @default(now()) @db.Date
  matkhau     String?
  trangthai   Int       @default(1)
  sodienthoai Int?
  token       String?
  otp         String?
  manhomquyen Int?

  nhomQuyen NhomQuyen? @relation(fields: [manhomquyen], references: [manhomquyen])

  @@map("nguoidung")
}

/// Nhóm quyền (role hệ thi) — bảng `nhomquyen`
model NhomQuyen {
  manhomquyen  Int     @id @default(autoincrement())
  tennhomquyen String
  trangthai    Boolean @default(true)

  nguoiDung    NguoiDung[]
  chiTietQuyen ChiTietQuyen[]

  @@map("nhomquyen")
}

/// Chi tiết quyền (role × chức năng × hành động) — bảng `chitietquyen`
model ChiTietQuyen {
  manhomquyen Int
  chucnang    String
  hanhdong    String

  nhomQuyen       NhomQuyen       @relation(fields: [manhomquyen], references: [manhomquyen], onDelete: Cascade)
  danhMucChucNang DanhMucChucNang @relation(fields: [chucnang], references: [chucnang])

  @@id([manhomquyen, chucnang, hanhdong])
  @@map("chitietquyen")
}

/// Danh mục chức năng (resource) — bảng `danhmucchucnang`
model DanhMucChucNang {
  chucnang    String  @id
  tenchucnang String?

  chiTietQuyen ChiTietQuyen[]

  @@map("danhmucchucnang")
}

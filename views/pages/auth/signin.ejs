<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('../../partials/head') %>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=block" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fc; }
    .text-gradient { background: linear-gradient(45deg, #1E90FF, #00C9A7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .shadow-elevated { box-shadow: 0 15px 30px rgba(0,0,0,0.1); }
    .btn-primary:hover { background: #0d6efd; }
    .alert { padding: 12px 16px; border-radius: 6px; font-weight: 500; margin-top: 15px; display: none; }
    .alert-success { background-color: #d1e7dd; color: #0f5132; border-left: 5px solid #198754; }
    .alert-danger { background-color: #f8d7da; color: #842029; border-left: 5px solid #dc3545; }
  </style>
</head>
<body>
  <div class="container-fluid min-vh-100">
    <div class="row g-0 min-vh-100">
      <!-- BÊN TRÁI: FORM -->
      <div class="col-md-6 d-flex align-items-center justify-content-center bg-white">
        <div class="p-5 w-100 shadow-elevated rounded-5" style="max-width: 450px;">
          <div class="text-center mb-4">
            <a class="fs-1 fw-bold text-decoration-none"><span class="text-gradient">LianHarman</span></a>
            <p class="text-muted fw-semibold text-uppercase mt-2">Đăng nhập</p>
            <div id="loginError" class="alert"></div>
          </div>
          <form id="loginForm" method="POST">
            <div class="mb-3">
              <label class="form-label fw-semibold">Mã SV - GV</label>
              <input type="text" class="form-control form-control-lg rounded-4 shadow-sm" name="id" placeholder="Nhập mã sinh viên hoặc giảng viên" required />
            </div>
            <div class="mb-4">
              <label class="form-label fw-semibold">Mật khẩu</label>
              <input type="password" class="form-control form-control-lg rounded-4 shadow-sm" name="password" placeholder="Nhập mật khẩu" required />
            </div>
            <div class="d-grid mb-3">
              <button id="loginBtn" type="submit" class="btn btn-lg btn-primary rounded-4 shadow-sm">
                <span class="btn-text">Đăng nhập</span>
              </button>
            </div>
            <div class="d-flex justify-content-between mt-4 small">
              <a class="text-muted" href="/auth/recover"><i class="fa fa-question-circle me-1"></i> Quên mật khẩu?</a>
              <a class="text-muted" href="/auth/signup"><i class="fa fa-user-plus me-1"></i> Tạo tài khoản</a>
            </div>
            <div class="text-center mt-4">
              <a href="/" class="btn btn-outline-secondary btn-sm rounded-3 px-4">
                <i class="fa fa-arrow-left me-1"></i> Quay lại trang chủ
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- BÊN PHẢI: ẢNH NỀN -->
      <div class="col-md-6 d-none d-md-flex align-items-center justify-content-center text-dark text-center p-5"
        style="background: url('https://y7b6t9n6.delivery.rocketcdn.me/wp-content/uploads/2024/01/SVG-3.svg') center/cover no-repeat; position: relative;">
        <div style="position: absolute; inset: 0; background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(8px);"></div>
        <div class="position-relative p-5" style="max-width: 500px;">
          <h1 class="fw-bold mb-3" style="font-size: 2.5rem;"><span class="text-gradient">LianHarman</span></h1>
          <p class="fs-5 text-dark fw-normal mb-4">Hệ thống tạo và quản lý bài thi cá nhân hóa</p>
          <p class="small text-muted">© <span id="year-copy"></span> LianHarman</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('year-copy').textContent = new Date().getFullYear();

    $(function () {
      $('#loginForm').on('submit', function (e) {
        e.preventDefault();
        const $btn = $('#loginBtn');
        const $text = $btn.find('.btn-text');
        const $err = $('#loginError');

        $btn.prop('disabled', true);
        $text.html('<i class="fa fa-spinner fa-spin me-2"></i> Đang xử lý...');

        $.ajax({
          url: '/auth/login',          // endpoint NestJS (thay /auth/checkLogin của PHP)
          type: 'POST',
          data: $(this).serialize(),    // id=...&password=... (urlencoded, Nest tự parse vào DTO)
        })
          .done(function () {
            $err.removeClass('alert-danger').addClass('alert alert-success').text('Đăng nhập thành công').fadeIn();
            window.location.href = '/dashboard';
          })
          .fail(function (xhr) {
            const msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Đã xảy ra lỗi khi đăng nhập!';
            $err.removeClass('alert-success').addClass('alert alert-danger').text(msg).fadeIn();
          })
          .always(function () {
            $btn.prop('disabled', false);
            $text.html('Đăng nhập');
          });
      });
    });
  </script>
</body>
</html>
